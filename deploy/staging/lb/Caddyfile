# ayat-lb: the staging API's load balancer (docs/09 «Two API copies + one worker»), inside our compose
# project only. The host Caddy terminates TLS and proxies to 127.0.0.1:3110 → here (:8080).
{
	# Inside the container only (roll.sh: caddy reload); never published.
	admin localhost:2019
	auto_https off
	persist_config off
	servers {
		# The host Caddy reaches us from a private address: keep its X-Forwarded-For (the visitor) and
		# append that address, so the API (TRUST_PROXY_HOPS=2) sees the visitor's real IP.
		trusted_proxies static private_ranges
	}
}

:8080 {
	# The internal routes (the worker's kicks, the peer config reload) are for the project network only:
	# the copies call each other by name (PEER_URLS), never through here.
	@internal path /internal /internal/*
	respond @internal 404

	reverse_proxy ayat-api-a:3000 ayat-api-b:3000 {
		lb_policy round_robin
		# A copy that is down or restarting refuses the connection: try the other one (never re-sent
		# once the request reached a copy, so a POST is never applied twice).
		lb_retries 2
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri /health
		health_interval 2s
		health_timeout 2s
		health_fails 2
		health_passes 1
	}
}

# Files (docs/45-minio-storage.md): the host Caddy proxies files.ayatalbayan.com here too; this host only goes
# to MinIO, every other one stays on the :8080 site above. MinIO checks each signed URL against the Host header,
# which Caddy passes on unchanged. Upstreams resolve per request: without the minio profile Caddy still starts
# and this host answers 502.
http://files.ayatalbayan.com:8080 {
	# MinIO's own admin and metrics routes are for the project network only; the health probe stays public.
	@minio_internal {
		path /minio/*
		not path /minio/health/*
	}
	respond @minio_internal 404

	# No request body limit here: the API caps each file's size and type when it signs the upload.
	reverse_proxy ayat-minio:9000 {
		# Replace MinIO's own: a stored file is never sniffed into HTML, runs no script and sends no Referer.
		# No CSP sandbox: Chrome refuses to show a PDF in a sandboxed page (the report links).
		header_down X-Content-Type-Options nosniff
		header_down Referrer-Policy no-referrer
		header_down Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; form-action 'none'; base-uri 'none'"
	}
}
