{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/livekit/token-server.mjs"],
      "ignoreBinaries": ["supabase"]
    },
    "docs/design/brand/tools": {
      "entry": ["build.mjs", "check.mjs"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/scripts/*.ts", "src/modules/messaging/inbox/files/pdf/pdf-sandbox.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/modules/*/*/index.ts"],
      "ignoreDependencies": ["@fontsource/amiri", "@fontsource/ibm-plex-sans-arabic"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/routes/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/routeTree.gen.ts"],
      "ignoreDependencies": ["babel-plugin-react-compiler", "zod"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "app.config.ts", "jest.setup.cjs"],
      "project": ["{app,src}/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "react-test-renderer",
        "expo-system-ui",
        "expo-blur",
        "expo-clipboard",
        "expo-sharing",
        "zod"
      ]
    },
    "packages/db": {
      "ignore": ["src/types.ts", "supabase/**"]
    },
    "packages/client-core": {
      "ignoreDependencies": ["zod"]
    },
    "tools/scripts": {
      "entry": ["**/*.{mjs,ts}", "!**/*.test.*"],
      "project": ["**/*.{mjs,ts}"]
    },
    "tools/migrate": {
      "entry": ["src/cli.ts"]
    },
    "tools/wa-stub": {
      "entry": ["src/server.ts"]
    },
    "tools/google-stub": {
      "entry": ["src/server.ts"]
    },
    "e2e": {
      "entry": [
        "playwright.config.ts",
        "tests/**/*.ts",
        "support/durations-reporter.ts",
        "scripts/*.ts"
      ],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["api", "web"]
    }
  },
  "ignoreUnresolved": ["vite/client"]
}
