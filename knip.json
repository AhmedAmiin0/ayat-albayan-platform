{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/livekit/token-server.mjs",
        "oxlint.full.config.ts",
        "docs/design/family-app/render.mjs"
      ],
      "ignoreBinaries": ["supabase"]
    },
    "docs/design/brand/tools": {
      "entry": ["build.mjs", "check.mjs"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/scripts/*.ts", "src/modules/messaging/inbox/files/pdf/pdf-sandbox.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/modules/*/*/index.ts"],
      "ignoreDependencies": ["@fontsource/amiri", "@fontsource/ibm-plex-sans-arabic"]
    },
    "apps/staff-web": {
      "entry": ["src/main.tsx", "src/routes/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/routeTree.gen.ts"],
      "ignoreDependencies": ["zod"]
    },
    "apps/family-web": {
      "entry": ["src/main.tsx", "src/routes/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/routeTree.gen.ts"],
      "ignoreDependencies": ["zod"]
    },
    "apps/staff-mobile": {
      "entry": ["index.ts", "app/**/*.{ts,tsx}", "app.config.ts", "jest.setup.cjs"],
      "project": ["{app,src}/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "react-test-renderer",
        "expo-system-ui",
        "expo-blur",
        "expo-clipboard",
        "expo-sharing",
        "zod"
      ]
    },
    "apps/family-mobile": {
      "entry": ["index.ts", "app/**/*.{ts,tsx}", "app.config.ts", "jest.setup.cjs"],
      "project": ["{app,src}/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "react-test-renderer",
        "expo-system-ui",
        "expo-splash-screen",
        "expo-document-picker",
        "zod"
      ]
    },
    "packages/db": {
      "ignore": ["src/types.ts", "supabase/**"]
    },
    "packages/client-core": {
      "ignoreDependencies": ["zod"]
    },
    "packages/mobile-kit": {
      "entry": ["src/index.ts", "babel.cjs", "jest.base.cjs", "jest.shared.cjs"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "react-test-renderer",
        "@expo/ui",
        "@livekit/react-native",
        "@livekit/react-native-webrtc",
        "livekit-client",
        "expo-screen-capture"
      ]
    },
    "packages/web-kit": {
      "entry": ["src/**/*.{ts,tsx}", "src/index.css"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tools/scripts": {
      "entry": ["**/*.{mjs,ts}", "!**/*.test.*"],
      "project": ["**/*.{mjs,ts}"]
    },
    "tools/migrate": {
      "entry": ["src/cli.ts"]
    },
    "tools/wa-stub": {
      "entry": ["src/server.ts"]
    },
    "tools/google-stub": {
      "entry": ["src/server.ts"]
    },
    "e2e": {
      "entry": [
        "playwright.config.ts",
        "tests/**/*.ts",
        "support/durations-reporter.ts",
        "scripts/*.ts"
      ],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["api", "staff-web"]
    }
  },
  "ignoreUnresolved": ["vite/client"]
}
