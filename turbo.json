{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__snapshots__/**",
        "!**/fixtures/**",
        "!**/*.md"
      ],
      "outputs": ["dist/**"]
    },
    "lint": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md"] },
    "typecheck": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md"] },
    "test": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md"] },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["E2E_LINES", "E2E_DURATIONS_FILE", "PWTEST_SHARD_WEIGHTS"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
