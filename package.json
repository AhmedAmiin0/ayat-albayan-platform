{
  "name": "ayat-albayan",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo build --filter='./packages/*' --output-logs=errors-only && node tools/scripts/ci-checks/lint/oxlint/run.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:prune": "turbo build --filter='./packages/*' --output-logs=errors-only && node tools/scripts/ci-checks/lint/oxlint/run.mjs --prune",
    "lint:report": "oxlint -c oxlint.config.ts --type-aware --deny-warnings --report-unused-disable-directives-severity=error --format json",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "supabase": "pnpm --filter @ab/db exec supabase",
    "env:local": "node tools/scripts/env/write-local-env.mjs",
    "seed:demo": "node --env-file-if-exists=e2e/.env tools/scripts/seed/seed-demo.mjs",
    "clear:demo": "node --env-file-if-exists=e2e/.env tools/scripts/seed/clear-demo.mjs",
    "seed:test-account": "node --env-file-if-exists=e2e/.env tools/scripts/seed/seed-test-account.mjs",
    "migrate": "pnpm --filter @ab/migrate cli",
    "migrate:dry": "pnpm --filter @ab/migrate cli dry-run",
    "migrate:apply": "pnpm --filter @ab/migrate cli apply",
    "test:all": "turbo lint typecheck test e2e --force",
    "guard:dup": "jscpd && node tools/scripts/ci-checks/jscpd-gate.mjs",
    "guard:knip": "knip --reporter json --no-exit-code | node tools/scripts/ci-checks/knip-gate.mjs",
    "guard:lint": "node tools/scripts/ci-checks/lint/lint-gate.mjs",
    "guard:escapes": "node tools/scripts/ci-checks/lint/escapes/gate.mjs",
    "guard:baselines": "node tools/scripts/ci-checks/lint/baselines/gate.mjs",
    "guard:loosened": "node tools/scripts/ci-checks/lint/loosened/run.mjs",
    "guard:queries": "node tools/scripts/ci-checks/lint/queries-gate.mjs",
    "guard:cycles": "node tools/scripts/ci-checks/lint/cycles-gate.mjs",
    "guard:packages": "node tools/scripts/ci-checks/lint/packages-gate.mjs",
    "guard:tsconfig": "node tools/scripts/ci-checks/lint/tsconfig/gate.mjs",
    "guard:comments": "node tools/scripts/ci-checks/comment-only/gate.mjs",
    "guard:units": "node tools/scripts/units/guard.ts",
    "guard:move-only": "node tools/scripts/units/move-only/gate.mjs",
    "units:fold": "node tools/scripts/units/fold.ts",
    "imports:absolute": "node tools/scripts/imports/absolute-imports.mjs"
  },
  "devDependencies": {
    "@ab/config": "workspace:*",
    "jscpd": "4.0.5",
    "knip": "5.88.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "postgres": "^3.4.9",
    "turbo": "^2.11.6"
  }
}
