{
  "name": "ayat-albayan",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "supabase": "pnpm --filter @ab/db exec supabase",
    "env:local": "node tools/scripts/env/write-local-env.mjs",
    "seed:demo": "node --env-file-if-exists=e2e/.env tools/scripts/seed/seed-demo.mjs",
    "clear:demo": "node --env-file-if-exists=e2e/.env tools/scripts/seed/clear-demo.mjs",
    "seed:test-account": "node --env-file-if-exists=e2e/.env tools/scripts/seed/seed-test-account.mjs",
    "migrate": "pnpm --filter @ab/migrate cli",
    "migrate:dry": "pnpm --filter @ab/migrate cli dry-run",
    "migrate:apply": "pnpm --filter @ab/migrate cli apply",
    "test:all": "turbo lint typecheck test e2e --force"
  },
  "prettier": "@ab/config/prettier",
  "devDependencies": {
    "@ab/config": "workspace:*",
    "@ab/shared": "workspace:*",
    "postgres": "^3.4.9",
    "prettier": "^3.6.0",
    "turbo": "^2.11.6"
  }
}
