{
  "name": "@ab/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "dev": "tsgo --noEmit --watch",
    "typecheck": "tsgo --noEmit",
    "gen:types": "supabase gen types typescript --local > src/types.ts && oxfmt src/types.ts",
    "reset": "supabase db reset"
  },
  "devDependencies": {
    "@ab/config": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3"
  }
}
