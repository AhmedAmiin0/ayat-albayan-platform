{
  "name": "@ab/shared",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./i18n/ar.json": "./i18n/ar.json",
    "./i18n/en.json": "./i18n/en.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ab/config": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@ab/core": "workspace:*",
    "@ab/db": "workspace:*",
    "@ab/i18n": "workspace:*",
    "@ab/time": "workspace:*",
    "zod": "^4.6.5"
  }
}
