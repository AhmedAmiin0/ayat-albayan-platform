{
  "name": "@ab/web-kit",
  "private": true,
  "type": "module",
  "description": "Shared React DOM code of the staff web app (apps/staff-web) and the family web app (apps/family-web), docs/51 §2: SOURCE, built by each app's Vite and resolved through `exports`.",
  "exports": {
    "./index.css": "./src/index.css",
    "./auth/me": "./src/auth/me/index.ts",
    "./auth/sign-in": "./src/auth/sign-in/index.ts",
    "./boot/maintenance": "./src/boot/maintenance/index.ts",
    "./boot/route-states": "./src/boot/route-states/index.ts",
    "./classroom/recordings/recording-format": "./src/classroom/recordings/recording-format/index.ts",
    "./classroom/room/components/ClassroomRoom": "./src/classroom/room/components/ClassroomRoom/index.ts",
    "./classroom/room/livekit/livekit-room": "./src/classroom/room/livekit/livekit-room/index.ts",
    "./classroom/room/livekit/snapshot": "./src/classroom/room/livekit/snapshot/index.ts",
    "./components/channel/ChannelThread": "./src/components/channel/ChannelThread/index.ts",
    "./components/legal": "./src/components/legal/index.ts",
    "./components/shell": "./src/components/shell/index.ts",
    "./components/ui/display/query-state": "./src/components/ui/display/query-state/index.ts",
    "./components/ui/layout/tabs": "./src/components/ui/layout/tabs/index.ts",
    "./components/ui/overlay/more-menu": "./src/components/ui/overlay/more-menu/index.ts",
    "./components/ui/surface/warn-line": "./src/components/ui/surface/warn-line/index.ts",
    "./lib/http/api": "./src/lib/http/api/index.ts",
    "./lib/http/env": "./src/lib/http/env/index.ts",
    "./portal/history/HistoryPanel": "./src/portal/history/HistoryPanel/index.ts",
    "./portal/recordings/RecordingsPanel": "./src/portal/recordings/RecordingsPanel/index.ts",
    "./report": "./src/report/index.ts",
    "./schedule/tz": "./src/schedule/tz/index.ts",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "dev": "tsgo --noEmit --watch",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ab/catalog": "workspace:*",
    "@ab/client-core": "workspace:*",
    "@ab/core": "workspace:*",
    "@ab/i18n": "workspace:*",
    "@ab/money": "workspace:*",
    "@ab/schedule": "workspace:*",
    "@ab/settings": "workspace:*",
    "@ab/shared": "workspace:*",
    "@ab/time": "workspace:*",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ab/config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "~19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
