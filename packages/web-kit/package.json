    "./auth": "./src/auth/index.ts",
    "./boot": "./src/boot/index.ts",
    "./channel": "./src/components/channel/index.ts",
    "./classroom": "./src/classroom/index.ts",
    "./display": "./src/components/ui/display/index.ts",
    "./form": "./src/components/ui/form/index.ts",
    "./http": "./src/lib/http/index.ts",
    "./i18n": "./src/lib/i18n/index.ts",
    "./index.css": "./src/index.css",
    "./layout": "./src/components/ui/layout/index.ts",
    "./legal": "./src/components/legal/index.ts",
    "./lesson-files": "./src/lesson-files/index.ts",
    "./lib": "./src/lib/index.ts",
    "./motion": "./src/lib/motion/index.ts",
    "./overlay": "./src/components/ui/overlay/index.ts",
    "./portal": "./src/portal/index.ts",
    "./push": "./src/push/index.ts",
    "./report": "./src/report/index.ts",
    "./schedule": "./src/schedule/index.ts",
    "./session": "./src/lib/session/index.ts",
    "./settings": "./src/lib/settings/index.ts",
    "./shell": "./src/components/shell/index.ts",
    "./surface": "./src/components/ui/surface/index.ts",
    "./testing": "./src/testing/index.ts",
    "./time": "./src/lib/time/index.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ab/client-core": "workspace:*",
    "@ab/i18n": "workspace:*",
    "@ab/shared": "workspace:*",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ab/config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "~19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.0.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
