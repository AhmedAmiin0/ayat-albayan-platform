{
  "name": "api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "config:import-env": "node --env-file-if-exists=.env dist/scripts/config-import-env.js"
  },
  "dependencies": {
    "@ab/db": "workspace:*",
    "@ab/shared": "workspace:*",
    "@fastify/static": "^7.0.4",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@supabase/supabase-js": "^2.117.2",
    "google-auth-library": "^11.3.1",
    "ioredis": "5.11.1",
    "jose": "^6.2.12",
    "playwright-core": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ab/config": "workspace:*",
    "@nestjs/testing": "^10.4.22",
    "@swc-node/register": "^1.11.0",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
