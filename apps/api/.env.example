# Written by `pnpm env:local` from `supabase status`. Never commit real values.
# Integration keys (WA_*, KAPSO_*, LIVEKIT_*, EXPO_*, WEB_PUSH_*, FX_API_URL, GOOGLE_CLIENT_ID/SECRET;
# @ab/shared integrations/keys.ts) may instead be saved by an admin in /admin/settings → «التكاملات»
# (Postgres + Vault): a non-empty DB value wins, these stay the fallback (docs/09 «Integration config
# in the database»). The rest below is bootstrap env and stays in env only. Academy settings and
# custom values never live here (docs/25-settings-and-config.md).
PORT=3000
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Default: ExchangeRate-API open access (no key). Base must be SAR.
FX_API_URL=https://open.er-api.com/v6/latest/SAR

# WhatsApp Cloud API (docs/12 §3). All optional: without them nothing is sent.
# Local/e2e: tools/wa-stub only. Never put the academy's real WABA values in a local .env.
WA_API_BASE=http://localhost:4010
WA_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=stub-phone
WA_WABA_ID=stub-waba
WA_ACCESS_TOKEN=local-token
WA_APP_ID=stub-app
WA_APP_SECRET=local-app-secret
WA_VERIFY_TOKEN=local-verify
# Signs the feedback-form links (>= 32 chars). Unset = «ابعت طلب الرأي» answers 503. Production: Vault.
FEEDBACK_TOKEN_SECRET=
# Online classrooms (LiveKit): all three or none; unset = the join routes answer 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lesson recordings: Supabase Storage S3 endpoint (bucket `recordings`). All five or none (tools/livekit/README.md).
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=
RECORDING_S3_BUCKET=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
# Sending is switched only in /admin/settings («إرسال الرسائل», settings.messaging_enabled, off by
# default) plus the allow-list WA_ALLOWED_RECIPIENTS; there is no env switch for it (docs/23, owner 2026-10-22).
# false = ignore the database's integration config (env only). Default true.
# INTEGRATION_CONFIG_FROM_DB=true
# How often (ms) the database's integration config is re-read. Unset = SETTINGS_CACHE_MS (30 s).
# INTEGRATION_REFRESH_MS=
# Optional: Expo push security token.
EXPO_ACCESS_TOKEN=
# Expo push API (production: https://exp.host). Unset = pushes stay on the server (local, e2e).
EXPO_API_BASE=
