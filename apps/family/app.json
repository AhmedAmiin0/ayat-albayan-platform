{
  "expo": {
    "name": "Ayat Al-Bayan",
    "slug": "ayat-albayan-family",
    "owner": "holdmycup",
    "scheme": "ayatalbayanfamily",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "router": {}
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayatalbayan.family"
    },
    "android": {
      "package": "com.ayatalbayan.family",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#064E3B",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#18201D"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نحتاج إلى Face ID لفتح التطبيق بوجهك بدل إدخال الرمز في كل مرة."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
