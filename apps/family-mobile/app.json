{
  "expo": {
    "name": "Ayat Al-Bayan",
    "slug": "ayat-albayan-family",
    "owner": "holdmycup",
    "scheme": "ayatalbayanfamily",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "router": {}
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayatalbayan.family"
    },
    "android": {
      "package": "com.ayatalbayan.family",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#064E3B",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#18201D"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "نحتاج إلى الكاميرا لتصوير الصور وإرسالها إلى الأكاديمية، وللظهور بالفيديو في الحلقات من داخل التطبيق.",
          "photosPermission": "نحتاج إلى الصور لاختيار صورة وإرسالها إلى الأكاديمية.",
          "microphonePermission": "نحتاج إلى الميكروفون لتسجيل الرسائل الصوتية، وللتحدث في الحلقات من داخل التطبيق."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "نحتاج إلى الميكروفون لتسجيل الرسائل الصوتية، وللتحدث في الحلقات من داخل التطبيق.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "نحتاج إلى الميكروفون لتسجيل الرسائل الصوتية، وللتحدث في الحلقات من داخل التطبيق.",
          "cameraPermission": "نحتاج إلى الكاميرا لتصوير الصور وإرسالها إلى الأكاديمية، وللظهور بالفيديو في الحلقات من داخل التطبيق."
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نحتاج إلى Face ID لفتح التطبيق بوجهك بدل إدخال الرمز في كل مرة."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
