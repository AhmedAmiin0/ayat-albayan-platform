{
  "expo": {
    "name": "آيات البيان — الإدارة",
    "slug": "ayat-albayan-admin",
    "owner": "holdmycup",
    "scheme": "ayatalbayan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "729e0cc3-f51d-4dab-b263-a107c7da8da8"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayatalbayan.admin"
    },
    "android": {
      "package": "com.ayatalbayan.admin",
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "محتاجين الكاميرا عشان تصوّر إيصال التحويل وتسجّله مع الدفعة.",
          "photosPermission": "محتاجين الصور عشان تختار صورة إيصال التحويل وتسجّلها مع الدفعة.",
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/729e0cc3-f51d-4dab-b263-a107c7da8da8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
