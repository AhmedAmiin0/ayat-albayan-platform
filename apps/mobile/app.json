{
  "expo": {
    "name": "آيات البيان — الإدارة",
    "slug": "ayat-albayan-admin",
    "owner": "holdmycup",
    "scheme": "ayatalbayan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {},
      "eas": {
        "projectId": "729e0cc3-f51d-4dab-b263-a107c7da8da8"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayatalbayan.admin",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "package": "com.ayatalbayan.admin",
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      ["expo-notifications", { "defaultChannel": "default" }]
    ]
  }
}
