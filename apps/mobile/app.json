{
  "expo": {
    "name": "آيات البيان — الإدارة",
    "slug": "ayat-albayan-admin",
    "owner": "holdmycup",
    "scheme": "ayatalbayan",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "729e0cc3-f51d-4dab-b263-a107c7da8da8"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayatalbayan.admin"
    },
    "android": {
      "package": "com.ayatalbayan.admin",
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "نحتاج إلى الكاميرا لتصوير إيصال التحويل وتسجيله مع الدفعة، وللظهور بالفيديو في الحلقات والاجتماعات من داخل التطبيق.",
          "photosPermission": "نحتاج إلى الصور لاختيار صورة إيصال التحويل وتسجيلها مع الدفعة.",
          "microphonePermission": "نحتاج إلى الميكروفون لإجراء المكالمات الصوتية عبر واتساب مع الأسر، وللتحدث في الحلقات والاجتماعات من داخل التطبيق."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "نحتاج إلى الميكروفون لإجراء المكالمات الصوتية عبر واتساب مع الأسر، وللتحدث في الحلقات والاجتماعات من داخل التطبيق.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "نحتاج إلى الميكروفون لإجراء المكالمات الصوتية عبر واتساب مع الأسر، وللتحدث في الحلقات والاجتماعات من داخل التطبيق.",
          "cameraPermission": "نحتاج إلى الكاميرا لتصوير إيصال التحويل وتسجيله مع الدفعة، وللظهور بالفيديو في الحلقات والاجتماعات من داخل التطبيق."
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/729e0cc3-f51d-4dab-b263-a107c7da8da8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
