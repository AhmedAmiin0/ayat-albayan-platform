{
  "expo": {
    "name": "آيات البيان — الإدارة",
    "slug": "ayat-albayan-admin",
    "scheme": "ayatalbayan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayatalbayan.admin"
    },
    "android": {
      "package": "com.ayatalbayan.admin",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font"
    ]
  }
}
