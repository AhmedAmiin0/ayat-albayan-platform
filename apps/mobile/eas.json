{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "node": "24.15.0",
      "pnpm": "11.25.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "node": "24.15.0",
      "pnpm": "11.25.0"
    },
    "stripe-test": {
      "distribution": "internal",
      "channel": "stripe-test",
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_FEATURE_STRIPE": "1",
        "APP_VARIANT": "stripetest",
        "EXPO_PUBLIC_API_URL": "https://staging-api.ayatalbayan.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://gqkqbxxgqttfbbqoqedf.supabase.co",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://staging-app.ayatalbayan.com"
      },
      "node": "24.15.0",
      "pnpm": "11.25.0"
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://staging-api.ayatalbayan.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://gqkqbxxgqttfbbqoqedf.supabase.co",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://staging-app.ayatalbayan.com"
      },
      "node": "24.15.0",
      "pnpm": "11.25.0"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "node": "24.15.0",
      "pnpm": "11.25.0"
    }
  },
  "submit": {
    "production": {}
  }
}
