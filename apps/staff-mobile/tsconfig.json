{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Mirrors what expo/tsconfig.base (expo 57) sets apart from the root base; re-check on an Expo upgrade.
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "customConditions": ["react-native"],
    "allowJs": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": null,
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/babel.config.js",
    "${configDir}/metro.config.js",
    "${configDir}/jest.config.js",
    "${configDir}/android",
    "${configDir}/ios"
  ]
}
