{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "ci-checks/move-module.ts",
    "ci-checks/move-module/**/*.ts",
    "ci-checks/deploy/**/*.ts",
    "imports/**/*.ts",
    "automerge/**/*.ts",
    "units/**/*.ts"
  ]
}
