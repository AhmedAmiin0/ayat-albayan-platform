# Copy to tools/migrate/.env (git-ignored). Names only — values live in .claude/artifacts/ (never committed).

# Drive export (default: newest tools/drive-download-*.zip in the main checkout's tools/)
MIGRATE_ZIP=

# Owner's WhatsApp CRM — READ-ONLY (.claude/artifacts/crm/crm.env)
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_KEY=
# CRM_ACCOUNT_ID=fcd54b00-5215-4470-8671-12b4d97d4220

# --target local (defaults to the supabase CLI database on :54322)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --target staging: session pooler, port 5432 (.claude/artifacts/staging/supabase.md + api.env)
# postgresql://postgres.knxfwiimjcifwckhwbim:<db_password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
STAGING_DATABASE_URL=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# --target production: refused unless --confirm-production (owner confirmation required)
PRODUCTION_DATABASE_URL=
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
